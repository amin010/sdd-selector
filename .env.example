# Copy to .env and fill in. .env is gitignored. Empty keys are fine:
# tools/qc/llm.mjs falls back to its deterministic mock provider.

# Optional. Used by the QC experiment scripts (npm run qc:*), not by the page.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional model overrides. See tools/qc/llm.mjs.
QC_PERSONA_MODEL=
QC_RESPOND_MODEL=
QC_JUDGE_MODEL=
QC_JUDGE_0_MODEL=
QC_JUDGE_1_MODEL=
QC_JUDGE_2_MODEL=
QC_JUDGE_0_PROVIDER=
QC_JUDGE_1_PROVIDER=
QC_JUDGE_2_PROVIDER=
